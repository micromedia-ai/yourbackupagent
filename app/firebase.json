{
  "hosting": {
    "public": "dist",
    "ignore": ["firebase.json", "**/.*"],
    "rewrites": [
      { "source": "/mcp", "function": { "functionId": "mcp", "region": "us-central1" } },
      { "source": "/mcp/**", "function": { "functionId": "mcp", "region": "us-central1" } },
      { "source": "/.well-known/oauth-protected-resource", "function": { "functionId": "mcp", "region": "us-central1" } },
      { "source": "/.well-known/oauth-protected-resource/**", "function": { "functionId": "mcp", "region": "us-central1" } },
      { "source": "/.well-known/oauth-authorization-server", "function": { "functionId": "mcp", "region": "us-central1" } },
      { "source": "/.well-known/oauth-authorization-server/**", "function": { "functionId": "mcp", "region": "us-central1" } },
      { "source": "**", "destination": "/index.html" }
    ],
    "headers": [
      { "source": "**", "headers": [
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ] },
      { "source": "/assets/**", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] }
    ]
  },
  "functions": { "source": "functions", "runtime": "nodejs22", "ignore": ["node_modules", "test", ".git"] },
  "firestore": { "rules": "firestore.rules", "indexes": "firestore.indexes.json" },
  "emulators": {
    "auth": { "port": 9099 },
    "firestore": { "port": 8086 },
    "functions": { "port": 5001 },
    "storage": { "port": 9199 },
    "hosting": { "port": 5055 },
    "ui": { "enabled": false },
    "singleProjectMode": true
  }
}

# Backup settings for one Firebase project. Copy to backup-kit/backup.env and fill in.
# Read by backup-kit/backup.sh and the GitHub workflows. Plain KEY=value lines,
# no secrets: everything here is a name, never a key or a password.
# Every other project that uses the kit has its own copy of this file;
# the kit itself lives in micromedia-ai/yourbackupagent.

# Version of YourBackupAgent this project runs (a tag of
# micromedia-ai/yourbackupagent; the workflow's `uses: ...@v1` should match).
KIT_REF=v1

# --- The project being backed up -------------------------------------------
PROJECT_ID=my-firebase-project
PROJECT_LABEL="My project"
# GitHub repository (rebuild drills start its "Rebuild drill" workflow).
REPO=owner/repo
# Service account GitHub Actions signs in as (the client_email of the
# deploy key in the repository's secrets). Leave empty and run
# `backup-kit/backup.sh setup` once: it lists the candidates.
CI_SA=

# --- Daily backup -----------------------------------------------------------
# Bucket in the project itself. After every good backup, sets older than
# BACKUP_KEEP_DAYS are deleted, but the newest KEEP_MIN_SETS good sets are
# always kept, however old (so failing nights never empty the bucket).
BACKUP_BUCKET=my-firebase-project-backups
BACKUP_KEEP_DAYS=14
KEEP_MIN_SETS=7
# Firestore databases to export: auto = every database except drill-* ones.
FIRESTORE_DATABASES=auto
# Storage buckets to copy: auto = the Firebase default bucket(s).
STORAGE_BUCKETS=auto
# Media copies: full = every set holds a full copy of every file; changed =
# each set copies only files that are new or changed since the last one into a
# shared store, gs://BACKUP_BUCKET/files/ (and the vault's files/). Every set
# still restores in full; store files no set refers to are deleted after the
# nightly prune. Archives always hold full copies.
STORAGE_MODE=full
# Realtime Database instances: auto = every instance that has data; none = skip.
RTDB=auto
# Regions to look in for scheduled jobs in the config snapshot.
REGIONS="us-east1 us-central1"
# Google-managed daily Firestore backup kept this many days (max 98).
MANAGED_KEEP_DAYS=14
# The daily check fails when the newest good backup is older than this.
MAX_AGE_HOURS=26

# --- Off-site copies, archives and drills (shared by every project) ---------
# Google account that owns the vault and drill projects.
VAULT_ACCOUNT=dagan.gilat@gmail.com
# Vault project: off-site copies and archives. GitHub never gets access to it.
VAULT_PROJECT=yourbackupagent
# This project's off-site bucket in the vault (bucket names are global).
OFFSITE_BUCKET=yourbackupagent-my-project
OFFSITE_KEEP_DAYS=90
# Archive bucket in the vault, shared by every project (archive/<project>/<run>).
ARCHIVE_BUCKET=yourbackupagent-archive
# Drill project: Firebase project the rebuild drill restores into and deploys
# to. Wiped at the start of every drill, so it only ever holds one copy.
DRILL_PROJECT=yourbackupagent-drill

# --- Rebuild drill ----------------------------------------------------------
# Secrets the drill site gets with their REAL values (for example keys the
# site needs to work at all) (copied into the vault by
# `backup.sh vault-secrets`, then into the drill project at drill time; never
# written to a backup file). Every other secret gets a placeholder, so email,
# payments, AI and identity providers stay off in the drill.
CHAIN_SECRETS=
# KMS keys the code expects (location/keyring/key). The drill gets new, empty
# keys with the same names: KMS keys never leave their project, so user
# wallets encrypted in production do not decrypt in the drill.
DRILL_KMS_KEYS=
# The repository's workflow that deploys the site into the drill project.
DRILL_WORKFLOW=rebuild-drill.yml
# What rebuild drills bring up and check besides the data. Empty: detected
# from the repository (web = Hosting, api = Cloud Functions, service = a
# Dockerfile, mobile = an iOS or Android app). Or a list such as "web api".
# The app shows the detected parts and changes this by pull request.
DRILL_PARTS=
# A path on the drill site that must answer 2xx (for example /api/health,
# best a function that reads a few collection counts). Empty: the first
# Hosting rewrite to a function must answer anything but 404 or 5xx.
HEALTH_PATH=
